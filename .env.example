# Copy to .env (or run `npm run setup`, which fills in random secrets).

# Local dev uses the embedded server from `npm run db`. In production use a managed Postgres URL
# with ?sslmode=require.
DATABASE_URL="postgresql://hollowmere:__PG_PASSWORD__@127.0.0.1:5433/hollowmere"

# Public origin of the site, used for Stripe redirect URLs.
APP_URL="http://localhost:3000"

# Set to "true" only behind a reverse proxy that overwrites X-Forwarded-For (Vercel, nginx, Cloudflare).
TRUST_PROXY="false"

# First admin account, created by `npm run db:seed`. Change the password after the first login.
ADMIN_EMAIL="admin@hollowmere.local"
ADMIN_PASSWORD="__ADMIN_PASSWORD__"

# Stable key for encrypting Server Action closures across instances (32 bytes, base64).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="__ACTIONS_KEY__"

# Stripe test mode. Leave empty to run checkout in demo mode (orders are marked paid without payment).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
